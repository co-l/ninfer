# Copy this file to .env (git-ignored) and adjust. Every key here is optional:
# the deploy scripts fall back to these same defaults when a key is missing.
# Precedence is: shell environment > .env > built-in defaults.
#
# Syntax: KEY=value. Values may be bare or wrapped in single/double quotes.
# Comments (#) and blank lines are ignored. No variable expansion happens
# inside the file — write literal paths.

# ── Remote host ─────────────────────────────────────────────────────────────
# BOX is the ssh host of the inference box (an alias in ~/.ssh/config works).
# REMOTE_DIR is the source tree on the box; the ssh user needs write access.
BOX=inference-box
REMOTE_DIR=/opt/ninfer

# ── Image build ─────────────────────────────────────────────────────────────
IMAGE=localhost/ninfer:local
BUILD_PARALLEL=16

# ── Container runtime ───────────────────────────────────────────────────────
# podman (default, what the box runs) or docker.
CONTAINER_RUNTIME=podman
# sudo prefix for the runtime commands. Leave empty when the current user can
# run the runtime directly (e.g. a docker group member).
CONTAINER_SUDO=sudo
CONTAINER_NAME=ninfer-serve
GPU_DEVICE=0

# ── Ports ───────────────────────────────────────────────────────────────────
HOST_PORT=8000
CONTAINER_PORT=8000

# ── Model ───────────────────────────────────────────────────────────────────
# Path to the artifact as seen inside the container (models/ is mounted ro).
ARTIFACT=/models/qwen3_8_27b_nvfp4.ninfer
MODEL_ID=qwen3.8-27b

# ── Serving flags ───────────────────────────────────────────────────────────
MAX_CONTEXT=262144
CONCURRENCY=4
MAX_PENDING_REQUESTS=16
PENDING_TIMEOUT_MS=600000
DEVICE_STATE_SLOTS=4
HOST_STATE_SLOTS=32
HOST_KV_MIB=16384
MAX_PRIVATE_CONTINUATIONS=128
MAX_SHARED_PREFIXES=64
KV_CAPACITY=460000
KV_DTYPE=nvfp4
SPEC=mtp
DRAFT_TOKENS=4
LM_HEAD_DRAFT=1
PRESERVE_THINKING=1
VISION=1
# Full-precision server/request log. OPT-IN: leave empty for normal serving;
# set it (e.g. REQUEST_LOG=/logs/requests.jsonl) for debug or bench runs only.
# The log grows unbounded (hundreds of MiB over time) — no rotation built in.
REQUEST_LOG=

# ── Mounts ──────────────────────────────────────────────────────────────────
# Extra -v mounts, space-separated, e.g. to serve an artifact kept in the HF
# cache without copying it (mount the cache root read-only and symlink the
# artifact into models/):
#   EXTRA_MOUNTS="-v /home/<user>/.cache/huggingface:/home/<user>/.cache/huggingface:ro"
EXTRA_MOUNTS=

# ── Logs ────────────────────────────────────────────────────────────────────
# Serve log path on the box. Defaults to $REMOTE_DIR/serve.log; if you set it
# here, write a literal path (no variable expansion happens in this file).
# SERVE_LOG=/var/log/ninfer/serve.log
